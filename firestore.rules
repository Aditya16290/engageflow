rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'adityakumar16290@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt']) &&
               data.uid is string && data.uid == request.auth.uid &&
               data.email is string && data.email.size() <= 200 &&
               data.displayName is string && data.displayName.size() <= 100 &&
               data.photoURL is string && data.photoURL.size() <= 500 &&
               data.role in ['user', 'admin'] &&
               (data.createdAt is timestamp || data.createdAt.size() > 0) &&
               (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
               (!('theme' in data) || (data.theme in ['light', 'dark']));
      }

      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        (incoming().role == 'user') || 
        (incoming().role == 'admin' && isAdmin())
      );
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Action: Update Profile
        (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'theme']) &&
         incoming().role == existing().role && incoming().email == existing().email) ||
        // Action: Self-Admin (for root user)
        (isAdmin() && incoming().role == 'admin')
      );
    }

    match /blogPosts/{postId} {
      function isValidBlogPost(data) {
        return data.keys().hasAll(['title', 'excerpt', 'tag', 'date', 'authorId', 'content', 'createdAt']) &&
               data.title is string && data.title.size() <= 200 &&
               data.excerpt is string && data.excerpt.size() <= 2000 &&
               data.content is string && data.content.size() <= 50000 &&
               data.tag is string && data.tag.size() <= 50 &&
               data.authorId == request.auth.uid;
      }

      allow read: if true;
      allow create: if isAdmin() && isValidBlogPost(incoming());
      allow update: if isAdmin() && isValidBlogPost(incoming());
      allow delete: if isAdmin();
    }

    match /contacts/{contactId} {
      function isValidContact(data) {
        return data.keys().hasAll(['name', 'email', 'message']) &&
               data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 200 &&
               data.message is string && data.message.size() <= 5000;
      }

      allow create: if isValidContact(incoming());
      allow read, update, delete: if isAdmin();
    }
  }
}
